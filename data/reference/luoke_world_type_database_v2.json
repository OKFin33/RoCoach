  "notes": {
    "damage_multiplier": {
      "3.0": "双重克制（双属性目标的两个属性都被克制）",
      "2.0": "单克制",
      "1.0": "等倍（或克制+抵抗相互抵消）",
      "0.5": "单抵抗",
      "0.333": "双重抵抗（双属性目标的两个属性都抵抗，即 ÷3）"
    },
    "dual_type_rule": "注意：双属性倍率不是简单乘法。双重克制=×3（非×4），双重抵抗=÷3（非×0.25），克制+抵抗=×1",
    "stab": "本系加成（STAB）存在，倍率为 ×1.25，即精灵使用与自身属性相同的技能时威力提升25%",
    "status_immunity": "仅收录已确认的状态免疫"
  },
  "damage_formula": {
    "simplified": "伤害 = 进攻方攻击 ÷ 防御方防御 × 0.9 × 显示威力 × 不稳定加成 × 连击数 × (1-减伤)",
    "detailed": "伤害 = 进攻方攻击 ÷ 防御方防御 × 0.9 × (技能威力 × 应对倍率 + 固定威力) × 威力提升buff × 本系加成 × 克制关系 × 能力等级 × 天气影响",
    "ability_level": "能力等级 = (1 ± 我方攻击等级变化 ± 敌方防御等级变化)",
    "notes": [
      "显示威力 = 对战中技能右下角的威力，已自动计算各种加成",
      "不稳定加成 = 应对成功的倍率提升、风起印记等（不自动计入显示威力）",
      "多个减伤效果之间乘算"
    ]
  },
