# Safe sample config only.
# Do not place real secrets in the repository.
# Copy the native-model block to ~/.config/roco-advisor/env and replace the
# placeholder API key locally if you want to enable pydantic_ai_native.

# Local API process defaults used by scripts/run_local_api.sh
ROCO_API_HOST=127.0.0.1
ROCO_API_PORT=8000

# Optional managed-persona local runtime opt-in.
# Keep this placeholder to stay on built-in-only persona fallback.
# Point it to a generated PersonaProjectionProfileMaterialization YAML artifact
# only for local testing of already-reviewed public-safe materialized profiles.
ROCO_MANAGED_PERSONA_MATERIALIZATION_PATH=replace-with-materialized-profile-path

# Native advisor runtime sample. Deterministic API/CLI paths do not require this.
ROCO_ADVISOR_MODEL=kimi-k2.5
ROCO_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ROCO_OPENAI_API_KEY=replace-with-live-local-secret
